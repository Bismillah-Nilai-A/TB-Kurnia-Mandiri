generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pengguna {
  id_pengguna String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama        String   @db.VarChar(50)
  username    String   @unique @db.VarChar(20)
  password    String   @db.Text
  role        String   @default("kasir") @db.VarChar(10)
  status      String   @default("aktif") @db.VarChar(10)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  log_aktivitas log_aktivitas[]
  mutasi_barang mutasi_barang[]
  transaksi     transaksi[]
  pengiriman    pengiriman[]

  @@map("pengguna")
}

model log_aktivitas {
  id_log       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pengguna_id  String?  @db.Uuid
  modul        String   @db.VarChar(30)
  aktivitas    String   @db.VarChar(50)
  data_sebelum Json?
  data_sesudah Json?
  waktu        DateTime @default(now()) @db.Timestamptz(6)

  pengguna Pengguna? @relation(fields: [pengguna_id], references: [id_pengguna], onDelete: SetNull)

  @@index([pengguna_id], map: "idx_log_aktivitas_pengguna_id")
  @@map("log_aktivitas")
}

model notifikasi {
  id_notifikasi String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jenis         String   @db.VarChar(30)
  penerima      String   @db.VarChar(100)
  saluran       String   @default("email") @db.VarChar(10)
  pesan         String   @db.Text
  status_kirim  String   @default("pending") @db.VarChar(10)
  waktu         DateTime @default(now()) @db.Timestamptz(6)

  @@map("notifikasi")
}

model Pelanggan {
  id_pelanggan  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama          String   @db.VarChar(50)
  jenis         String   @default("perorangan") @db.VarChar(10)
  kontak        String?  @db.VarChar(20)
  alamat        String?  @db.Text
  batas_kasbon  Decimal  @default(0) @db.Decimal(15, 2)
  status_kasbon String   @default("aktif") @db.VarChar(10)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  transaksi transaksi[]
  kasbon    kasbon[]

  @@map("pelanggan")
}

model kasbon {
  id_kasbon         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pelanggan_id      String    @db.Uuid
  transaksi_id      String?   @db.Uuid
  jumlah_kasbon     Decimal   @default(0) @db.Decimal(15, 2)
  status            String    @default("menunggu") @db.VarChar(10)
  alasan_penolakan  String?   @db.Text
  tanggal_pengajuan DateTime  @default(now()) @db.Timestamptz(6)
  tanggal_keputusan DateTime? @db.Timestamptz(6)

  pelanggan Pelanggan  @relation(fields: [pelanggan_id], references: [id_pelanggan], onDelete: Cascade)
  transaksi transaksi? @relation(fields: [transaksi_id], references: [id_transaksi], onDelete: SetNull)

  @@index([pelanggan_id], map: "idx_kasbon_pelanggan_id")
  @@index([transaksi_id], map: "idx_kasbon_transaksi_id")
  @@map("kasbon")
}

model transaksi {
  id_transaksi     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no_nota          String   @unique @db.VarChar(20)
  pengguna_id      String?  @db.Uuid
  pelanggan_id     String?  @db.Uuid
  jenis_pembayaran String   @db.VarChar(10)
  total            Decimal  @default(0) @db.Decimal(15, 2)
  jumlah_dibayar   Decimal  @default(0) @db.Decimal(15, 2)
  sisa_tagihan     Decimal  @default(0) @db.Decimal(15, 2)
  status_bayar     String   @default("menunggu") @db.VarChar(10)
  perlu_dikirim    Boolean  @default(false)
  tanggal          DateTime @default(now()) @db.Timestamptz(6)

  pengguna         Pengguna?          @relation(fields: [pengguna_id], references: [id_pengguna], onDelete: SetNull)
  pelanggan        Pelanggan?         @relation(fields: [pelanggan_id], references: [id_pelanggan], onDelete: SetNull)
  detail_transaksi detail_transaksi[]
  pembayaran       pembayaran[]
  kasbon           kasbon[]
  pengiriman       pengiriman[]
  penukaran        penukaran[]

  @@index([pengguna_id], map: "idx_transaksi_pengguna_id")
  @@index([pelanggan_id], map: "idx_transaksi_pelanggan_id")
  @@map("transaksi")
}

model detail_transaksi {
  id_detail_transaksi String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaksi_id        String   @db.Uuid
  satuan_barang_id    String   @db.Uuid
  jumlah              Decimal  @default(1) @db.Decimal(15, 2)
  harga_awal          Decimal  @default(0) @db.Decimal(15, 2)
  harga_nego          Decimal? @db.Decimal(15, 2)
  harga_satuan        Decimal  @default(0) @db.Decimal(15, 2)
  subtotal            Decimal  @default(0) @db.Decimal(15, 2)

  transaksi     transaksi     @relation(fields: [transaksi_id], references: [id_transaksi], onDelete: Cascade)
  satuan_barang satuan_barang @relation(fields: [satuan_barang_id], references: [id_satuan_barang], onDelete: Cascade)

  @@index([transaksi_id], map: "idx_detail_transaksi_transaksi_id")
  @@index([satuan_barang_id], map: "idx_detail_transaksi_satuan_barang_id")
  @@map("detail_transaksi")
}

model pembayaran {
  id_pembayaran      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaksi_id       String   @db.Uuid
  metode             String   @db.VarChar(10)
  nominal            Decimal  @default(0) @db.Decimal(15, 2)
  bukti_transfer_url String?  @db.Text
  referensi_gateway  String?  @db.VarChar(50)
  status             String   @default("berhasil") @db.VarChar(10)
  tanggal            DateTime @default(now()) @db.Timestamptz(6)

  transaksi transaksi @relation(fields: [transaksi_id], references: [id_transaksi], onDelete: Cascade)

  @@index([transaksi_id], map: "idx_pembayaran_transaksi_id")
  @@map("pembayaran")
}

model Barang {
  id_barang           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_barang         String   @unique @db.VarChar(20)
  nama                String   @db.VarChar(50)
  kategori            String   @db.VarChar(30)
  barcode             String?  @unique @db.VarChar(30)
  barcode_fisik       Boolean  @default(true)
  satuan_dasar        String   @default("Pcs") @db.VarChar(15)
  stok                Decimal  @default(0) @db.Decimal(15, 2)
  stok_minimum        Decimal  @default(5) @db.Decimal(15, 2)
  satuan_pembelian    String   @default("Pcs") @db.VarChar(15)
  isi_per_satuan_beli Decimal  @default(1) @db.Decimal(15, 2)
  harga_beli          Decimal  @default(0) @db.Decimal(15, 2)
  harga_modal         Decimal  @default(0) @db.Decimal(15, 2)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  satuan_barang        satuan_barang[]
  rencana_restok       rencana_restok[]
  detail_mutasi_barang detail_mutasi_barang[]

  @@map("barang")
}

model satuan_barang {
  id_satuan_barang String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barang_id        String  @db.Uuid
  nama_satuan      String  @db.VarChar(20)
  jumlah_konversi  Decimal @default(1) @db.Decimal(15, 2)
  harga_modal      Decimal @default(0) @db.Decimal(15, 2)
  margin_persen    Decimal @default(30) @db.Decimal(5, 2)
  harga_jual_awal  Decimal @default(0) @db.Decimal(15, 2)

  barang                Barang             @relation(fields: [barang_id], references: [id_barang], onDelete: Cascade)
  detail_transaksi      detail_transaksi[]
  detail_penukaran_asal detail_penukaran[] @relation("SatuanAsal")
  detail_penukaran_baru detail_penukaran[] @relation("SatuanPengganti")

  @@index([barang_id], map: "idx_satuan_barang_barang_id")
  @@map("satuan_barang")
}

model rencana_restok {
  id_restok     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barang_id     String   @db.Uuid
  jumlah_restok Decimal  @default(0) @db.Decimal(15, 2)
  status        String   @default("direncanakan") @db.VarChar(10)
  tanggal       DateTime @default(now()) @db.Timestamptz(6)

  barang Barang @relation(fields: [barang_id], references: [id_barang], onDelete: Cascade)

  @@index([barang_id], map: "idx_rencana_restok_barang_id")
  @@map("rencana_restok")
}

model pemasok {
  id_pemasok String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama       String   @db.VarChar(50)
  kontak     String?  @db.VarChar(20)
  alamat     String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)

  mutasi_barang   mutasi_barang[]
  tagihan_pemasok tagihan_pemasok[]

  @@map("pemasok")
}

model mutasi_barang {
  id_mutasi      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pengguna_id    String?  @db.Uuid
  pemasok_id     String?  @db.Uuid
  jenis          String   @db.VarChar(10)
  no_surat_jalan String?  @db.VarChar(30)
  jenis_bayar    String?  @db.VarChar(10)
  tujuan         String?  @db.VarChar(50)
  alasan         String?  @db.Text
  tanggal        DateTime @default(now()) @db.Timestamptz(6)

  pengguna             Pengguna?              @relation(fields: [pengguna_id], references: [id_pengguna], onDelete: SetNull)
  pemasok              pemasok?               @relation(fields: [pemasok_id], references: [id_pemasok], onDelete: SetNull)
  detail_mutasi_barang detail_mutasi_barang[]
  tagihan_pemasok      tagihan_pemasok[]

  @@index([pengguna_id], map: "idx_mutasi_barang_pengguna_id")
  @@index([pemasok_id], map: "idx_mutasi_barang_pemasok_id")
  @@map("mutasi_barang")
}

model detail_mutasi_barang {
  id_detail_mutasi String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mutasi_id        String  @db.Uuid
  barang_id        String  @db.Uuid
  satuan_pembelian String  @default("Pcs") @db.VarChar(15)
  jumlah           Decimal @default(1) @db.Decimal(15, 2)
  harga_beli       Decimal @default(0) @db.Decimal(15, 2)
  subtotal         Decimal @default(0) @db.Decimal(15, 2)
  stok_sebelum     Decimal @default(0) @db.Decimal(15, 2)
  stok_sesudah     Decimal @default(0) @db.Decimal(15, 2)

  mutasi mutasi_barang @relation(fields: [mutasi_id], references: [id_mutasi], onDelete: Cascade)
  barang Barang        @relation(fields: [barang_id], references: [id_barang], onDelete: Cascade)

  @@index([mutasi_id], map: "idx_detail_mutasi_barang_mutasi_id")
  @@index([barang_id], map: "idx_detail_mutasi_barang_barang_id")
  @@map("detail_mutasi_barang")
}

model tagihan_pemasok {
  id_tagihan          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pemasok_id          String   @db.Uuid
  mutasi_id           String?  @db.Uuid
  jumlah_tagihan      Decimal  @default(0) @db.Decimal(15, 2)
  sisa_tagihan        Decimal  @default(0) @db.Decimal(15, 2)
  tanggal_jatuh_tempo DateTime @db.Date
  status              String   @default("belum_lunas") @db.VarChar(12)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  pemasok            pemasok              @relation(fields: [pemasok_id], references: [id_pemasok], onDelete: Cascade)
  mutasi             mutasi_barang?       @relation(fields: [mutasi_id], references: [id_mutasi], onDelete: SetNull)
  pembayaran_pemasok pembayaran_pemasok[]

  @@index([pemasok_id], map: "idx_tagihan_pemasok_pemasok_id")
  @@index([mutasi_id], map: "idx_tagihan_pemasok_mutasi_id")
  @@map("tagihan_pemasok")
}

model pembayaran_pemasok {
  id_pembayaran_pemasok String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tagihan_id            String   @db.Uuid
  nominal               Decimal  @default(0) @db.Decimal(15, 2)
  tanggal_bayar         DateTime @default(now()) @db.Timestamptz(6)
  keterangan            String?  @db.Text

  tagihan tagihan_pemasok @relation(fields: [tagihan_id], references: [id_tagihan], onDelete: Cascade)

  @@index([tagihan_id], map: "idx_pembayaran_pemasok_tagihan_id")
  @@map("pembayaran_pemasok")
}

model pengiriman {
  id_pengiriman     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaksi_id      String?   @db.Uuid
  pengirim_id       String?   @db.Uuid
  alamat_tujuan     String    @db.Text
  status            String    @default("belum_dikirim") @db.VarChar(20)
  foto_bukti_url    String?   @db.Text
  alasan_penukaran  String?   @db.Text
  tanggal_penugasan DateTime  @default(now()) @db.Timestamptz(6)
  tanggal_terima    DateTime? @db.Timestamptz(6)

  transaksi       transaksi?        @relation(fields: [transaksi_id], references: [id_transaksi], onDelete: SetNull)
  pengirim        Pengguna?         @relation(fields: [pengirim_id], references: [id_pengguna], onDelete: SetNull)
  laporan_kendala laporan_kendala[]

  @@index([transaksi_id], map: "idx_pengiriman_transaksi_id")
  @@index([pengirim_id], map: "idx_pengiriman_pengirim_id")
  @@map("pengiriman")
}

model laporan_kendala {
  id_laporan    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pengiriman_id String   @db.Uuid
  jenis_kendala String   @db.VarChar(30)
  deskripsi     String   @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  pengiriman pengiriman @relation(fields: [pengiriman_id], references: [id_pengiriman], onDelete: Cascade)

  @@index([pengiriman_id], map: "idx_laporan_kendala_pengiriman_id")
  @@map("laporan_kendala")
}

model penukaran {
  id_penukaran      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaksi_id      String    @db.Uuid
  status            String    @default("menunggu") @db.VarChar(15)
  alasan_penukaran  String?   @db.Text
  alasan_penolakan  String?   @db.Text
  selisih_harga     Decimal   @default(0) @db.Decimal(15, 2)
  tanggal_pengajuan DateTime  @default(now()) @db.Timestamptz(6)
  tanggal_selesai   DateTime? @db.Timestamptz(6)

  transaksi        transaksi          @relation(fields: [transaksi_id], references: [id_transaksi], onDelete: Cascade)
  detail_penukaran detail_penukaran[]

  @@index([transaksi_id], map: "idx_penukaran_transaksi_id")
  @@map("penukaran")
}

model detail_penukaran {
  id_detail_penukaran String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  penukaran_id        String  @db.Uuid
  satuan_asal_id      String  @db.Uuid
  satuan_pengganti_id String  @db.Uuid
  jumlah_kembali      Decimal @default(1) @db.Decimal(15, 2)
  kondisi_barang      String  @default("layak_jual") @db.VarChar(10)
  jumlah_pengganti    Decimal @default(1) @db.Decimal(15, 2)
  harga_pengganti     Decimal @default(0) @db.Decimal(15, 2)

  penukaran        penukaran     @relation(fields: [penukaran_id], references: [id_penukaran], onDelete: Cascade)
  satuan_asal      satuan_barang @relation("SatuanAsal", fields: [satuan_asal_id], references: [id_satuan_barang], onDelete: Cascade)
  satuan_pengganti satuan_barang @relation("SatuanPengganti", fields: [satuan_pengganti_id], references: [id_satuan_barang], onDelete: Cascade)

  @@index([penukaran_id], map: "idx_detail_penukaran_penukaran_id")
  @@index([satuan_asal_id], map: "idx_detail_penukaran_satuan_asal_id")
  @@index([satuan_pengganti_id], map: "idx_detail_penukaran_satuan_pengganti_id")
  @@map("detail_penukaran")
}
