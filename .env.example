# ── Supabase (PostgreSQL) ──────────────────────────────────────────────
# Ambil dari project Supabase → Settings → API
# NEXT_PUBLIC_* hanya bisa dibaca di client (browser), jadi ANON KEY cukup.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Midtrans Sandbox (QRIS / Virtual Account) ──────────────────────────
# Dashboard Midtrans → Developers → API Keys
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY = kunci untuk frontend/web (sandbox)
MIDTRANS_SERVER_KEY=<server-key>

# ── Email (API pihak ketiga, free & mudah) ────────────────────────────
# Resend (recommended) → API Keys
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=noreply@resend.com

# ── WhatsApp (Meta WhatsApp Cloud API) ────────────────────────────────
# Meta Business → WhatsApp Cloud API → Access Point
WHATSAPP_ACCESS_TOKEN=<whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<whatsapp-phone-number-id>

# ── (Opsional) Bearer Token 미들웨어 / auth service ──────────────────
# AJWAN_AUTH_SECRET=<secret-untuk-token-jwt>
